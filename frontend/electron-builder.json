{
  "appId": "com.forge.crm",
  "productName": "ForgeCRM",
  "copyright": "Copyright © 2026 Forge India Connect",
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "package.json",
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "public/login.png",
    "signAndEditExecutable": false,
    "forceCodeSigning": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Forge CRM"
  },
  "publish": null
}
